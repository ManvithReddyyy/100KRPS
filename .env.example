# Database Connection (PostgreSQL 16+)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safepath?sslmode=disable

# Redis Connection (Redis 7+)
REDIS_URL=redis://localhost:6379

# Server Port
PORT=8081

# Disable rate limiter for load testing (true/false)
DISABLE_RATE_LIMITER=true

# Enable Go pprof profiler on :6060 (true/false)
ENABLE_PPROF=false
